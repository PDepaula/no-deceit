{
  "module": "classify",
  "js": {"file": "core/classify.mjs", "fn": "classify"},
  "bb": {"ns": "no-deceit.classify", "fn": "classify"},
  "cases": [
    {"name": "read is inspect", "args": ["Read", {"file_path": "a.js"}], "expect": "A"},
    {"name": "write is source mutation", "args": ["Write", {"file_path": "src/a.js"}], "expect": "E"},
    {"name": "ls is inspect", "args": ["Bash", {"command": "ls"}], "expect": "A"},
    {"name": "nd tier is tamper", "args": ["Bash", {"command": "nd tier 3"}], "expect": "G"},
    {"name": "piped renderer is diagram", "args": ["Bash", {"command": "echo 'graph TD' | mmdc -i - -o a.svg"}], "expect": "H"},
    {"name": "renderer behind a runner is diagram", "args": ["Bash", {"command": "npx -y mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "dot -T is diagram", "args": ["Bash", {"command": "dot -Tpng in.dot > out.png"}], "expect": "H"},
    {"name": "renderer after a launcher assignment is diagram", "args": ["Bash", {"command": "env FOO=1 mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "renderer after launcher flag values is diagram", "args": ["Bash", {"command": "npx -y -p pkg mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "xargs with a flag value runs the renderer", "args": ["Bash", {"command": "ls *.mmd | xargs -n 1 mmdc -i"}], "expect": "H"},
    {"name": "sudo with a user runs the renderer", "args": ["Bash", {"command": "sudo -u me mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "dot with -T after other args is diagram", "args": ["Bash", {"command": "dot -Kneato -Tsvg a.dot -o a.svg"}], "expect": "H"},
    {"name": "dot with -T after the input is diagram", "args": ["Bash", {"command": "dot a.dot -Tsvg -o a.svg"}], "expect": "H"},
    {"name": "npx -p package then renderer is diagram", "args": ["Bash", {"command": "npx -p @mermaid-js/mermaid-cli mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "find -name a renderer is inspect", "args": ["Bash", {"command": "find . -name mmdc"}], "expect": "A"},
    {"name": "xargs boolean flag then grep is inspect", "args": ["Bash", {"command": "xargs -r grep mmdc"}], "expect": "A"},
    {"name": "sudo boolean flag then cat is inspect", "args": ["Bash", {"command": "sudo -n cat plantuml.txt"}], "expect": "A"},
    {"name": "env boolean flag then grep is inspect", "args": ["Bash", {"command": "env -i grep -rn mmdc core/"}], "expect": "A"},
    {"name": "time boolean flag then grep is inspect", "args": ["Bash", {"command": "time -p grep -rn mmdc core/"}], "expect": "A"},
    {"name": "chained launchers each in command position run the renderer", "args": ["Bash", {"command": "sudo -E -u me env -i FOO=1 mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "pnpm dlx runs the renderer", "args": ["Bash", {"command": "echo 'a -- b' | pnpm dlx d2 - a.svg"}], "expect": "H"},
    {"name": "find -exec runs the renderer", "args": ["Bash", {"command": "find . -name '*.mmd' -exec mmdc -i {} ;"}], "expect": "H"},
    {"name": "launcher word as a grep pattern is not a launcher", "args": ["Bash", {"command": "grep -r env docs mmdc"}], "expect": "A"},
    {"name": "launcher word as a type filter is not a launcher", "args": ["Bash", {"command": "rg -t sh mmdc core/"}], "expect": "A"},
    {"name": "launcher word as an extension filter is not a launcher", "args": ["Bash", {"command": "fd -e sh plantuml"}], "expect": "U"},
    {"name": "which env mmdc is inspect", "args": ["Bash", {"command": "which env mmdc"}], "expect": "A"},
    {"name": "bun x runs the renderer", "args": ["Bash", {"command": "bun x mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "yarn exec runs the renderer", "args": ["Bash", {"command": "yarn exec mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "npm x runs the renderer", "args": ["Bash", {"command": "npm x mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "command without a lookup flag runs the renderer", "args": ["Bash", {"command": "command mmdc -i a.mmd -o a.svg"}], "expect": "H"},
    {"name": "command -v is a lookup, not a render", "args": ["Bash", {"command": "command -v mmdc"}], "expect": "U"},
    {"name": "echo time mmdc is not a render", "args": ["Bash", {"command": "echo time mmdc"}], "expect": "A"},
    {"name": "grepping a renderer name is inspect", "args": ["Bash", {"command": "grep -rn mmdc core/"}], "expect": "A"},
    {"name": "reading renderer notes is inspect", "args": ["Bash", {"command": "cat docs/plantuml-notes.md"}], "expect": "A"},
    {"name": "grep dot is inspect", "args": ["Bash", {"command": "grep dot notes.txt"}], "expect": "A"}
  ]
}
