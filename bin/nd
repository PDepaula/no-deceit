#!/usr/bin/env node
// No Deceit — `nd` CLI: the developer's own out-of-band control channel.
//
// Set/show the tier and mode, unlock (blind grader or override), and read the
// ledger. This is one of the two forge-proof channels for state changes (the
// other is the developer's /no-deceit: prompt commands, handled in the hook).
// The model cannot use it to change its own tier: the PreToolUse gate denies
// any tool call that invokes a mutating `nd` subcommand (category G), and —
// as defense-in-depth if the gate is disabled — mutating subcommands here
// refuse when they detect they are running inside an agent shell (CLAUDECODE,
// CURSOR_AGENT, or PI_CODING_AGENT set). The grader is spawned from this CLI
// or the hook, never by the tutor.

import { defaultEnv, gitToplevel, dataPaths, homePaths, projectPaths, isGoverned, readLedger, readAllLedger, loadConfig, readProjectState } from '../core/state.mjs';
import { setTier, setMode, renderStatus, renderStatusShort } from '../core/control.mjs';
import { parseReportArgs, summarizeLedger, formatReport } from '../core/report.mjs';
import { parseUnlockArgs, parseCheckArgs, parseGradeArgs, parseEvidenceArgs } from '../core/unlock-args.mjs';
import { runUnlock, runCheck, runGrade, runAudit, probeGraderAuth } from '../core/grader.mjs';
import { initProject, projectAdd, bootstrap, update } from '../core/home.mjs';
import { CHECKOUT_ROOT } from '../core/state.mjs';
import { addEvidenceFile } from '../core/evidence-io.mjs';
import { ITEMS } from '../gold/unlock-gold.mjs';
import { ITEMS as TRANSFER_ITEMS } from '../gold/transfer-gold.mjs';

const env = defaultEnv();
const cwd = process.cwd();
const repoRoot = gitToplevel(cwd);
const sessionId = env.ND_SESSION || env.CLAUDE_SESSION_ID || null;

const MUTATING = new Set(['init', 'tier', 'mode', 'unlock', 'check', 'grade', 'evidence', 'project', 'bootstrap', 'update']);
const AGENT_SHELL_MARKERS = ['CLAUDECODE', 'CURSOR_AGENT', 'PI_CODING_AGENT'];

function die(msg, code = 1) { process.stderr.write(msg + '\n'); process.exit(code); }
function say(msg) { process.stdout.write(msg + '\n'); }

function inAgentShell() {
  return AGENT_SHELL_MARKERS.some((k) => env[k] && !env.ND_ALLOW_AGENT);
}

function guardAgentShell(sub) {
  if (MUTATING.has(sub) && inAgentShell()) {
    die(
      'No Deceit: refusing to run a state-changing `nd` subcommand from inside an ' +
      'agent shell. The agent may never change its own tier, and may never spawn ' +
      'the grader. Run this in your own terminal, or use the /no-deceit: prompt commands.',
    );
  }
}

if (process.argv.slice(2).includes('--cursor')) {
  const { runCursorHook } = await import('../harness/cursor/run.mjs');
  await runCursorHook({ stdin: process.stdin, stdout: process.stdout, env, cwd: repoRoot });
  process.exit(0);
}

function cmdInit() {
  const { paths: p, state: st } = initProject(repoRoot, env);
  say(`No Deceit initialised in ${p.dir}. This project is now governed (Tier ${st.tier}, mode ${st.mode}).`);
}

function flagValue(args, flag) {
  const i = args.indexOf(flag);
  return i >= 0 ? args[i + 1] : undefined;
}

const [sub, ...rest] = process.argv.slice(2);

switch (sub) {
  case undefined:
  case 'help':
  case '--help':
  case '-h':
    say(`nd — No Deceit control CLI

  nd init                         opt this project in (create .no-deceit/)
  nd tier <1|2|3>                 set the tier (3 is a time-boxed grant)
  nd mode <coach|pair|ask>        set the domain mode
  nd status [--short]             show the current tier/mode
  nd unlock [task]                grade .no-deceit/attempts/<task>.md (default task: default)
  nd unlock [task] --git [--files a,b] [--since SHA]
                                  grade commit history for the task's files
  nd unlock --appeal              re-grade the last verdict once
  nd unlock --override "<reason>" unlock anyway (typed reason, ledgered)
  nd check [task] [--project <p>] grade a checking-question answer (rubric must be written first)
  nd evidence add <topic> <path> [--project <p>]
                                  copy + hash a note, .mmd/.mermaid, .excalidraw or .excalidraw.md
                                  into the data home (evidence/<topic>/)
  nd grade [topic]                blind transfer grade of the newest evidence for the topic
                                  (default topic: the last one captured); same as /no-deceit:grade;
                                  a pass unlocks the project the evidence names (manifest path)
  nd audit [--runs 3]             run both gold sets; release gate is graded_up = 0
  nd ledger [N]                   show the last N ledger entries (default 20)
  nd report [--since <when>] [--until <when>]
                                  weekly-style ledger summary (default window: 7 days;
                                  --since/--until: ISO date or relative 7d/24h/30m/1w)
  nd project add <git-url|path> [--name n] [--summary "…"]
                                  clone (or adopt a local dir) into the home's projects/, register it in
                                  the data home's project manifest, and opt it in (nd init)
  nd bootstrap [--dry-run] [--claude] [--opencode] [--pi] [--cursor]
                                  create the home layout and link this checkout into each harness
                                  (default: every harness whose config dir exists)
  nd update                       fetch and fast-forward this checkout; print the release notes between
                                  the old and new HEAD (never touches projects/ data/ state/ config/)
  nd doctor [--grader-probe]      report paths (incl. the data home) and run the armed self-check;
                                  --grader-probe also runs a minimal grader login check
  nd --cursor                     Cursor preToolUse transport (stdin JSON → stdout decision);
                                  kept as a shim while the transport moves under harness/cursor/`);
    break;

  case 'init':
    guardAgentShell('init');
    cmdInit();
    break;

  case 'project': {
    guardAgentShell('project');
    if (rest[0] !== 'add') die('usage: nd project add <git-url|path> [--name n] [--summary "…"]');
    const home = env.ND_HOME || null;
    if (!home) die('No Deceit: this checkout is not a home yet. Run `nd bootstrap` first.');
    const args = rest.slice(1);
    const source = args.find((a, i) => !a.startsWith('--') && !['--name', '--summary'].includes(args[i - 1]));
    try {
      const r = projectAdd({ home, env, source, name: flagValue(args, '--name'), summary: flagValue(args, '--summary') });
      say(`${r.cloned ? 'Cloned' : 'Adopted'} ${r.name} at ${r.path}; registered in ${r.manifest}; governed at Tier ${r.tier}. Start your harness inside it.`);
    } catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'bootstrap': {
    guardAgentShell('bootstrap');
    const only = ['claude', 'opencode', 'pi', 'cursor'].filter((h) => rest.includes(`--${h}`));
    try { for (const l of bootstrap({ home: CHECKOUT_ROOT, env, only, dryRun: rest.includes('--dry-run') })) say(l); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'update': {
    guardAgentShell('update');
    try { for (const l of update({ home: CHECKOUT_ROOT })) say(l); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'tier': {
    guardAgentShell('tier');
    try { say(setTier({ repoRoot, env, sessionId, tier: rest[0] })); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'mode': {
    guardAgentShell('mode');
    try { say(setMode({ repoRoot, env, sessionId, mode: rest[0] })); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'unlock': {
    guardAgentShell('unlock');
    const args = parseUnlockArgs(rest);
    try { say(await runUnlock({ repoRoot, env, sessionId, ...args })); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'check': {
    guardAgentShell('check');
    const args = parseCheckArgs(rest);
    try { say(await runCheck({ repoRoot, env, sessionId, task: args.task, project: args.project })); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'evidence': {
    guardAgentShell('evidence');
    const { action, topic, filePath, project } = parseEvidenceArgs(rest);
    if (action !== 'add') die('usage: nd evidence add <topic> <path> [--project <p>]');
    try {
      const r = addEvidenceFile({ env, sessionId, topic, filePath, project });
      say(`Captured ${r.kind} for ${topic}: ${r.path} (${r.words} words, sha256 ${r.sha256.slice(0, 12)}…). \`nd grade ${topic}\` when ready.`);
    } catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'grade': {
    guardAgentShell('grade');
    const args = parseGradeArgs(rest);
    try { say(await runGrade({ repoRoot, env, sessionId, ...args })); }
    catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'audit': {
    const runsFlag = rest.indexOf('--runs');
    const cfg = loadConfig(env);
    const runs = runsFlag >= 0 ? Number(rest[runsFlag + 1]) || cfg.auditRuns : cfg.auditRuns;
    const oracle = rest.includes('--oracle') || env.ND_AUDIT_MOCK === 'oracle';
    const inflate = rest.includes('--inflate') || env.ND_AUDIT_MOCK === 'inflate';
    const items = [...ITEMS, ...TRANSFER_ITEMS];
    try {
      const invoke = oracle || inflate
        ? async ({ item }) => {
          if (inflate) {
            if (item.route === 'transfer') {
              const criteria = {};
              for (const id of ['P1', 'P2', 'P3', 'P4', 'P5']) criteria[id] = { met: true, span: 'inflated' };
              return { verdict: 'unlocked', criteria };
            }
            if (item.route === 'commit-history') {
              return { verdict: 'unlocked', criteria: { C1: { met: true, span: 'x' }, C2: { met: true, span: 'y' }, C3: { met: true, span: 'z' } } };
            }
            if (item.route === 'check') {
              const criteria = {};
              for (const id of Object.keys(item.gold_criteria || { Q1: 1 })) criteria[id] = { met: true, span: 'inflated' };
              return { verdict: 'landed', criteria };
            }
            return {
              verdict: 'unlocked',
              criteria: {
                R1: { met: true, span: 'x' }, R2: { met: true, span: 'y' },
                R3: { met: true, span: 'z' }, R4: { met: true, span: 'w' },
              },
            };
          }
          if (item.route === 'transfer') return { verdict: item.gold_verdict, criteria: item.gold_criteria || {}, structure: item.gold_structure || {}, misconceptions: item.gold_misconceptions || [] };
          return { verdict: item.gold_verdict, criteria: item.gold_criteria || {}, error_class: item.gold_error_class || 'conceptual', misconceptions: [] };
        }
        : undefined;
      const result = await runAudit({ items, runs, invoke, env });
      say(result.report);
      if (!result.pass) die('audit gate blocked: graded_up > 0', 1);
    } catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'status':
    say(rest.includes('--short')
      ? renderStatusShort({ repoRoot, env, sessionId })
      : renderStatus({ repoRoot, env, sessionId }));
    break;

  case 'report': {
    try {
      const nowMs = Date.now();
      const window = parseReportArgs(rest, nowMs);
      const summary = summarizeLedger(readAllLedger(env), { ...window, nowMs });
      say(formatReport(summary, { nowMs }));
    } catch (e) { die(`No Deceit: ${e.message}`); }
    break;
  }

  case 'ledger': {
    const n = Number(rest[0]) || 20;
    const entries = readLedger(env, n);
    if (entries.length === 0) { say('No Deceit ledger is empty.'); break; }
    for (const e of entries) say(JSON.stringify(e));
    break;
  }

  case 'doctor': {
    const home = homePaths(env);
    const proj = projectPaths(repoRoot);
    const cfg = loadConfig(env);
    say('No Deceit doctor');
    say(`  repo root:   ${repoRoot}`);
    say(`  governed:    ${isGoverned(repoRoot) ? 'yes' : 'no (run \`nd init\`)'}`);
    say(`  project dir: ${proj.dir}`);
    say(`  ledger:      ${home.ledger}`);
    say(`  home:        ${env.ND_HOME || `(none — XDG fallback; run \`nd bootstrap\` in a checkout)`}`);
    say(`  data home:   ${dataPaths(env).dataDir} (evidence/, verdicts/, curricula/, projects.{edn,json,md})`);
    say(`  config:      ${home.configFile}`);
    say(`  grader model:${cfg.graderModel} (override via config.json graderModel)`);
    say(`  grader timeout: ${cfg.graderTimeoutMs} ms`);
    try {
      const { decide } = await import('../core/policy.mjs');
      const r = decide({ tier: 1, mode: 'coach', t2Unlocked: false, t3Active: false, t3PreamblePresent: false, notes: [] }, { category: 'E' });
      say(`  gate armed:  ${r.decision === 'deny' ? 'yes (Tier 1 source write is denied)' : 'NO — gate not blocking!'}`);
    } catch (e) {
      say(`  gate armed:  NO — ${e.message}`);
    }
    if (rest.includes('--grader-probe')) {
      const probe = await probeGraderAuth({ env, model: cfg.graderModel });
      say(`  grader login: ${probe.ok ? 'ok — ' : 'FAIL — '}${probe.message}`);
    } else {
      say('  grader login: not checked (run nd doctor --grader-probe)');
    }
    break;
  }

  default:
    die(`nd: unknown subcommand "${sub}". Try \`nd help\`.`);
}
