{
  "name": "no-deceit",
  "version": "0.8.0",
  "description": "No Deceit home repo \u2014 a principle-transfer learning framework with a tier-enforcing gate. Installed by git clone, not npm (this manifest exists for Pi's package loader).",
  "type": "module",
  "license": "MIT",
  "author": "Patrick De Paula",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDepaula/no-deceit.git"
  },
  "homepage": "https://github.com/PDepaula/no-deceit#readme",
  "bugs": "https://github.com/PDepaula/no-deceit/issues",
  "keywords": [
    "ai",
    "coding-assistant",
    "learning",
    "tutor",
    "socratic",
    "gate",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./harness/pi/no-deceit.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test 'core/*.test.mjs' 'hooks/*.test.mjs' 'bin/*.test.mjs' 'harness/*.test.mjs'"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "private": true
}
